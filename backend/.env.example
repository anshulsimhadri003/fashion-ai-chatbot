# FastAPI backend configuration
# Leave OPENAI_API_KEY empty to run the fully local fallback demo.
OPENAI_API_KEY=

# Recommended low-latency API model for conversational responses.
OPENAI_MODEL=gpt-5.4-mini
USE_OPENAI=true

# Embeddings for FAISS vector search. If no OpenAI key is set, the app uses local hashing embeddings.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
USE_OPENAI_EMBEDDINGS=true
LOCAL_EMBEDDING_DIM=384
RAG_TOP_K=8
MAX_HISTORY=10

# React dev server origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
